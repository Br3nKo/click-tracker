# Copy to .env for local overrides:  cp .env.example .env
# All values below are the defaults from app/config.py (dev throwaway creds).
# Real environment variables override .env, which overrides these defaults.
# Hostnames `postgres`/`redis` work inside docker-compose; use `localhost`
# when running the app directly against locally-published containers.

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://clicks:clicks@postgres:5432/clicks
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis ---
REDIS_URL=redis://redis:6379/0
STREAM_KEY=clicks:incoming
CONSUMER_GROUP=enrichers
STREAM_MAX_LEN=5000000

# --- Worker / rate limiting ---
USER_SERVICE_RATE_LIMIT=200
RATE_LIMIT_KEY=ratelimit:user_service
WORKER_CONCURRENCY=50
BATCH_SIZE=100
BATCH_FLUSH_SECONDS=1.0

# --- Faked user service ---
USER_SERVICE_LATENCY=0.25
USER_SERVICE_CAPACITY=200
USER_SERVICE_WINDOW_KEY=userservice:window

# --- Cache ---
CACHE_TTL_SECONDS=1800
